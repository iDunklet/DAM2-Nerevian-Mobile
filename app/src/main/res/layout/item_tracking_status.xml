<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">

    <View
        android:id="@+id/lineTop"
        android:layout_width="2dp"
        android:layout_height="20dp"
        android:background="#2B6B78"
        app:layout_constraintBottom_toTopOf="@id/dotStatus"
        app:layout_constraintEnd_toEndOf="@id/dotStatus"
        app:layout_constraintStart_toStartOf="@id/dotStatus"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/dotStatus"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/shape_timeline_dot_active"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/lineBottom"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="#2B6B78"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/dotStatus"
        app:layout_constraintStart_toStartOf="@id/dotStatus"
        app:layout_constraintTop_toBottomOf="@id/dotStatus" />

    <TextView
        android:id="@+id/tvStatusTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Llegada a puerto de destino"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/dotStatus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/dotStatus"
        app:layout_constraintTop_toTopOf="@id/dotStatus" />

    <TextView
        android:id="@+id/tvStatusTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp"
        android:text="12 Oct 2023, 14:30"
        android:textColor="#888888"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tvStatusTitle"
        app:layout_constraintTop_toBottomOf="@id/tvStatusTitle" />

</androidx.constraintlayout.widget.ConstraintLayout>